package {{ group | replace('.', '/') | replace('/', '.') }}

import javafx.application.Application
import javafx.geometry.Insets
import javafx.geometry.Pos
import javafx.scene.Scene
import javafx.scene.canvas.Canvas
import javafx.scene.control.*
import javafx.scene.layout.*
import javafx.scene.paint.Color
import javafx.stage.Stage

// Ikonli
import org.kordamp.ikonli.javafx.FontIcon
import org.kordamp.ikonli.fontawesome5.FontAwesomeSolid

// ControlsFX
import org.controlsfx.control.PopOver
import org.controlsfx.control.Notifications

// FormsFX
import com.dlsc.formsfx.model.structure.Field
import com.dlsc.formsfx.model.structure.Form
import com.dlsc.formsfx.model.structure.Section
import com.dlsc.formsfx.view.renderer.FormRenderer

// ValidatorFX
import net.synedra.validatorfx.Validator

import kotlin.math.hypot

/**
 * JavaFX demo application for {{ app_name }}.
 * Shows usage of:
 *  - Ikonli (toolbar icon),
 *  - ControlsFX (Notifications, PopOver),
 *  - FormsFX (simple form on the left),
 *  - ValidatorFX (email field validation),
 *  - JavaFX Canvas (vector drawing + simple hit-testing).
 */
class App : Application() {
    override fun start(stage: Stage) {
        val root = BorderPane().apply { padding = Insets(12.0) }

        // --- Top: title with Ikonli icon ---
        val titleLabel = Label("{{ app_name }}").apply {
            graphic = FontIcon(FontAwesomeSolid.ROCKET)
            style = "-fx-font-size: 18px; -fx-font-weight: bold;"
        }
        val toolbar = HBox(12.0, titleLabel).apply {
            alignment = Pos.CENTER_LEFT
            padding = Insets(0.0, 0.0, 10.0, 0.0)
        }
        root.top = toolbar

        // --- Left: FormsFX form ---
        val nameField = Field.ofStringType("").label("Name").placeholder("Enter your name")
        val agreeField = Field.ofBooleanType(false).label("I agree to the terms")
        val form = Form.of(Section.of(nameField, agreeField).title("Profile"))
        val formRenderer = FormRenderer(form).apply {
            prefWidth = 360.0
        }

        // --- Center-left: validated email input using ValidatorFX ---
        val emailLabel = Label("Email")
        val emailInput = TextField().apply {
            promptText = "you@example.com"
            prefColumnCount = 24
        }

        val validator = Validator()
        val emailRegex = Regex("""^[\w.+-]+@[\w.-]+\.[A-Za-z]{2,}$""")
        validator.createCheck()
            .dependsOn("email", emailInput.textProperty())
            .withMethod { ctx ->
                val value = (ctx.get("email") as String?)?.trim().orEmpty()
                if (!emailRegex.matches(value)) {
                    ctx.error("Please enter a valid email address.")
                }
            }
            .decorates(emailInput)
            .immediate()

        val validateBtn = Button("Validate", FontIcon(FontAwesomeSolid.CHECK)).apply {
            isDefaultButton = true
        }

        val popOver = PopOver().apply {
            arrowLocation = PopOver.ArrowLocation.TOP_CENTER
        }

        validateBtn.setOnAction {
            if (validator.containsErrors()) {
                popOver.contentNode = Label("Validation failed.\nFix highlighted fields.")
                popOver.show(validateBtn)
            } else {
                if (popOver.isShowing) popOver.hide()
                Notifications.create()
                    .title("Validation")
                    .text("All inputs look good.")
                    .owner(stage)
                    .showInformation()
            }
        }

        val centerBox = VBox(8.0,
            HBox(10.0, emailLabel, emailInput),
            validateBtn
        ).apply {
            alignment = Pos.TOP_LEFT
            padding = Insets(0.0, 0.0, 0.0, 10.0)
        }

        val content = HBox(20.0, formRenderer, centerBox)

        // --- Right: Canvas demo with simple hit-testing ---
        val canvas = Canvas(320.0, 320.0)
        val g = canvas.graphicsContext2D

        // Simple scene parameters
        val cx = 160.0
        val cy = 160.0
        val r = 120.0

        // Draw base circle
        g.lineWidth = 2.0
        g.stroke = Color.DARKSLATEGRAY
        g.strokeOval(cx - r, cy - r, 2 * r, 2 * r)

        // Draw a marker dot
        val markerX = cx - 20.0
        val markerY = cy - 60.0
        g.fill = Color.DARKRED
        g.fillOval(markerX - 3.0, markerY - 3.0, 6.0, 6.0)

        // Optional sector lines
        g.stroke = Color.LIGHTGRAY
        for (i in 0 until 12) {
            val angle = Math.toRadians(i * 30.0)
            val x2 = cx + r * kotlin.math.cos(angle)
            val y2 = cy + r * kotlin.math.sin(angle)
            g.strokeLine(cx, cy, x2, y2)
        }

        // Basic hit test
        canvas.setOnMouseClicked { e ->
            val dx = e.x - cx
            val dy = e.y - cy
            val dist = hypot(dx, dy)

            val nearCircle = kotlin.math.abs(dist - r) < 6.0
            val nearMarker = hypot(e.x - markerX, e.y - markerY) <= 8.0

            val msg = when {
                nearMarker -> "Marker clicked at (%.1f, %.1f)".format(e.x, e.y)
                nearCircle -> "Circle ring clicked at (%.1f, %.1f)".format(e.x, e.y)
                else -> "Canvas clicked at (%.1f, %.1f)".format(e.x, e.y)
            }

            Notifications.create()
                .title("Canvas hit-test")
                .text(msg)
                .owner(stage)
                .showInformation()
        }

        // Place the canvas to the right of the existing content
        root.center = HBox(20.0, content, canvas)

        // --- Bottom status bar ---
        val status = Label("Ready").apply { textFill = Color.GRAY }
        root.bottom = HBox(status).apply {
            padding = Insets(10.0, 0.0, 0.0, 0.0)
        }

        stage.title = "{{ app_name }} ({{ group }})"
        stage.scene = Scene(root, 980.0, 520.0)
        stage.show()
    }
}
